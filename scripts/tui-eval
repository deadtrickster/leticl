#!/usr/bin/env python3
"""tui-eval — the CLI for a leticl head's eval socket (PLAN.md §8).

Usage:
  tui-eval FORM                 eval FORM in the (only) live head
  tui-eval --pid PID FORM       eval FORM in the head with that pid
  tui-eval --list               print the pids of the live heads

A head listens on <runtime-dir>/tui-<pid>.sock, where runtime-dir is
$XDG_RUNTIME_DIR, falling back to /tmp/leticl-<uid> (src/socket.lisp
runtime-dir). The line protocol is one request per line, `eval <form>`;
the reply is one JSON line {"ok":true,"value":"…","ms":N} or
{"ok":false,"error":"…"}.

Trust: this is arbitrary code execution in the head's image, by design —
the same trust a person at a REPL has. Per-user socket, mode 0600.
"""
import glob
import json
import os
import socket
import sys
import tempfile


def runtime_dir():
    # mirror src/socket.lisp runtime-dir exactly
    return os.environ.get("XDG_RUNTIME_DIR") or os.path.join(
        tempfile.gettempdir(), "leticl-{}".format(os.getuid()))


def socket_path(pid):
    return os.path.join(runtime_dir(), "tui-{}.sock".format(pid))


def list_heads():
    """The pids of the live heads, from the tui-<pid>.sock files."""
    pids = []
    for path in sorted(glob.glob(os.path.join(runtime_dir(), "tui-*.sock"))):
        name = os.path.basename(path)
        try:
            pids.append(int(name[4:-5]))  # strip 'tui-' and '.sock'
        except ValueError:
            pass
    return pids


def eval_form(pid, form):
    """Send `eval <form>` to the head and return the reply line."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(socket_path(pid))
        s.sendall(("eval " + form + "\n").encode("utf-8"))
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        return buf.decode("utf-8").rstrip("\n")
    finally:
        s.close()


def main(argv):
    args = argv[1:]
    pid = None
    do_list = False
    forms = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--list":
            do_list = True
        elif a == "--pid":
            i += 1
            if i >= len(args):
                print("--pid needs a value", file=sys.stderr)
                return 2
            pid = int(args[i])
        else:
            forms.append(a)
        i += 1

    if do_list:
        for p in list_heads():
            print(p)
        return 0

    form = " ".join(forms).strip()
    if not form:
        print(__doc__.strip(), file=sys.stderr)
        return 2

    if pid is None:
        heads = list_heads()
        if len(heads) == 1:
            pid = heads[0]
        elif not heads:
            print("no live leticl heads under " + runtime_dir(), file=sys.stderr)
            return 1
        else:
            print("multiple heads {}; use --pid".format(heads), file=sys.stderr)
            return 1

    try:
        reply = eval_form(pid, form)
    except OSError as e:
        print("cannot reach head {}: {}".format(pid, e), file=sys.stderr)
        return 1

    try:
        print(json.dumps(json.loads(reply), indent=2))
    except ValueError:
        print(reply)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
