#!/usr/bin/env python3
"""settle-diff — rebuild the screen from a raw pipe-pane capture and find the settle.

The capture is what the head WRITES, escape codes and all. Two facts make this
possible and one of them is the frame boundary:

  * the paint is wrapped in DEC 2026 synchronized output -- `ESC[?2026h` ... `ESC[?2026l` --
    so a FRAME is the bytes between those, not "until a row goes backwards". That
    was the first instrument's mistake and it produced 354 fragments instead of
    frames: the head paints only CHANGED cells, so a frame is usually two or
    three rows, and grouping on row order groups those, not the screen.
  * rows are addressed absolutely (`ESC[<r>;<c>H`), never scrolled -- measured:
    scroll-region ESC[r 0, index ESC D 0, reverse-index ESC M 0, clear ESC[2J 0.

So: keep a virtual screen, apply each frame's row writes, snapshot after each.
Then the settle is the frame where lines move, and the amount is its height.
"""
import io, re, sys

POS = re.compile(r"\x1b\[(\d+);(\d+)[Hf]")
SGR = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
FRAME = re.compile(r"\x1b\[\?2026([hl])")

def frames_of(path):
    raw = io.open(path, encoding="utf-8", errors="replace").read()
    screen, out, buf = {}, [], []
    for part in re.split(r"(\x1b\[\?2026[hl])", raw):
        m = FRAME.fullmatch(part) if part else None
        if m and m.group(1) == "h":
            buf = []
        elif m and m.group(1) == "l":
            for r, c, txt in buf:
                screen[r] = txt
            out.append((dict(screen), len(buf)))
            buf = []
        elif part:
            marks = list(POS.finditer(part))
            for i, mm in enumerate(marks):
                end = marks[i + 1].start() if i + 1 < len(marks) else len(part)
                txt = SGR.sub("", part[mm.end():end]).replace("\x1b", "")
                buf.append((int(mm.group(1)), int(mm.group(2)), txt[:200]))
    return out

def main(path, n=6):
    fs = frames_of(path)
    print("frames: %d (DEC 2026 delimited)" % len(fs))
    for i in range(max(0, len(fs) - n), len(fs)):
        scr, wrote = fs[i]
        print("  frame %-4d wrote %2d rows, screen %d rows" % (i, wrote, len(scr)))
    if len(fs) < 2:
        return
    a, b = fs[-2][0], fs[-1][0]
    van = [r for r in a if r not in b or b[r] != a[r]]
    print("\nlast frame vs the one before: %d rows differ" % len(van))
    moved = 0
    for r in sorted(van)[:10]:
        print("  r%-3d %r -> %r" % (r, a.get(r, "")[:48], b.get(r, "")[:48]))
        if a.get(r, "") != b.get(r, ""):
            moved += 1
    print("\n%d row(s) changed at the last frame" % moved)

main(sys.argv[1] if len(sys.argv) > 1 else "/tmp/settle.raw")
