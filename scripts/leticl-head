#!/usr/bin/env bash
# leticl-head — the leticl image, spoken to like `letibot-tui`.
#
# `~/bin/letibot` execs its head as
#
#     letibot-tui --socket S --identity U [--resume ID | --new-session TITLE]
#
# and, with `LETIBOT_HEAD` pointing here, execs this instead. Everything above the
# head — finding or starting the folder's daemon, the seat's defaults, --continue,
# --new — stays the launcher's; this only translates its arguments into the
# image's: the socket becomes $LETIBOT_SOCKET (how the image finds its daemon),
# `--resume ID` STAYS `--resume ID` (it is a different act from `--session` — see the arm
# below), `--new-session TITLE` becomes
# `--new TITLE`, and `--identity` is dropped — the image says `leticl` on the
# wire, which is what the daemon's head list should show for this head.
#
# It refuses an argument it does not know rather than guessing: a launcher that
# grows a flag this file has never seen must fail loudly here, not be silently
# attached without it.
#
# **AND IT ANSWERS THE TWO QUESTIONS A PERSON ASKS BEFORE ANY OF THAT.**
# `--help` and `--version` are handled above the launcher's arguments, because the
# person typing them is not the launcher — they are somebody who just installed
# this and wants to know what it is. Both used to fall through to the refusal
# above, which answers a question about the head with a sentence about a launcher.

set -euo pipefail

LETICL_HOME="${LETICL_HOME:-/home/dead/Projects/leticl}"
IMAGE="$LETICL_HOME/bin/leticl-head"

if [ ! -x "$IMAGE" ]; then
  echo "leticl: no head image at $IMAGE" >&2
  echo "        build it: (cd $LETICL_HOME && sbcl --script freeze.lisp)" >&2
  exit 1
fi

args=()
while [ $# -gt 0 ]; do
  case "$1" in
    # **THE FIRST THING A NEW PERSON TYPES, AND IT WAS REFUSED BY NAME.** `leticl-head --help`
    # fell to the arm below and printed *"unknown argument from the launcher: --help"* — a
    # sentence about a launcher the reader has never heard of, in answer to a question about the
    # head they just installed. MEASURED on the shipped script. The image has its own `-h`, so
    # this hands the question to the thing that can answer it.
    -h|--help)     exec "$IMAGE" -h ;;
    # **AND `--version` IS SBCL'S, WHETHER WE LIKE IT OR NOT.** The image is a frozen SBCL and
    # its runtime parses `--version` before any Lisp runs, so the honest answer is *the head has
    # no version of its own* followed by the runtime that is actually there. Printing one number
    # and calling it leticl's would be inventing a fact; printing nothing would look like a
    # failure to install.
    --version)     printf 'leticl-head: the head has no version of its own (the code lives in git).\n'
                   printf 'its runtime is: '
                   exec "$IMAGE" --version ;;
    --socket)      export LETIBOT_SOCKET="$2"; shift 2 ;;
    --identity)    shift 2 ;;
    # **`--resume` STAYS `--resume`** (T4 in TODO.md): the launcher passes the reference's flag
    # straight through, and the image does the one thing that can bring a session the daemon does
    # not hold into the conversation — ask for it once the Hello has delivered the list. Rewritten
    # to `--session` it named the id on the ATTACH, which the daemon refuses for a session it has
    # never opened, so a stored session was reachable from the picker and not from the CLI.
    --resume)      args+=(--resume "$2"); shift 2 ;;
    --new-session) args+=(--new "$2"); shift 2 ;;
    *) echo "leticl-head: unknown argument from the launcher: $1" >&2; exit 2 ;;
  esac
done

exec "$IMAGE" "${args[@]}"
